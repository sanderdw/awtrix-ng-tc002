-    :{hold:true,stack:false,name:LIVE_NAME,text:'',icon:m.dataBase64};
+  let data=m.dataBase64;
+  if(m.mode==='bitmap'){
+    // Send the drawing as an icon so the device places it like a saved icon of that size.
+    if(!(m.w>0&&m.h>0&&m.w<=ICON_MAX&&m.h<=ICON_MAX_HEIGHT))return;
+    const raw=atob(data),px=[];
+    if(raw.length!==m.w*m.h*3)return;
+    for(let i=0;i<raw.length;i+=3)px.push(raw.charCodeAt(i)<<16|raw.charCodeAt(i+1)<<8|raw.charCodeAt(i+2));
+    data=btoa(String.fromCharCode(...gifEncode([{t:0,px}],m.w,m.h,1)));
+  }
+  const body={hold:true,stack:false,name:LIVE_NAME,text:'',icon:data};
   piskelLiveQueue=piskelLiveQueue.catch(()=>{}).then(async()=>{
     if(!piskelLiveOn||generation!==piskelLiveGeneration)return;
     try{await post('/api/v1/notifications',body);lastLiveErr='';}
