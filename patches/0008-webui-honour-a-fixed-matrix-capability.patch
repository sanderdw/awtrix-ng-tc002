+async function validateIcon(file){
+  const header=new Uint8Array(await file.slice(0,10).arrayBuffer());
+  let w,h;
+  if(String.fromCharCode(...header.slice(0,3))==='GIF'){
+    w=header[6]|header[7]<<8;h=header[8]|header[9]<<8;
+  }else{
+    const bmp=await createImageBitmap(file);w=bmp.width;h=bmp.height;bmp.close();
+  }
+  if(!(w>0&&h>0&&w<=ICON_MAX&&h<=ICON_MAX_HEIGHT))
+    throw new Error('Image must fit within '+ICON_MAX+'×'+ICON_MAX_HEIGHT+' pixels.');
+}
 async function uploadFile(file,dir,name,onProgress){
+  if(dir==='/ICONS')await validateIcon(file);
   const url=dir.startsWith('/api/')?dir:'/api/v1/files?dir='+encodeURIComponent(dir);
   const x=await xhrPost(url,'file',file,name,onProgress);
   if(x.status>=300)throw new Error('HTTP '+x.status);
@@ -4399,9 +4440,16 @@ let piskelLiveOn=false,lastLiveErr='',piskelLiveGeneration=0,piskelLiveQueue=Pro
