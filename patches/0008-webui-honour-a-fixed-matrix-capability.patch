From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: awtrix-ng-tc002 <port@awtrix-ng-tc002.invalid>
Date: Wed, 16 Sep 2026 16:19:35 +0200
Subject: [PATCH 8/8] webui: honour a fixed-matrix capability

When capabilities report a fixed matrix, the GPIO, panel and sensor fields are
hidden, the live preview and icon limits follow the reported size, the icon
editor offers matching presets and firmware uploads accept .img files.

diff --git a/webui/index.html b/webui/index.html
index a9cf165..c2fd9f8 100644
--- a/webui/index.html
+++ b/webui/index.html
@@ -1588,6 +1588,20 @@ const SOUND_KEYS=Object.keys(SYSF).filter(k=>SYSF[k].api==='settings');
 const S={transitions:[],stats:null,ap:false,sysHost:'',sysUid:'',gpio:null,aud:null,
   scriptsOff:null};
 function readAudioCaps(caps){
+  // A board with a fixed matrix (a native port, say) reports its size and has no wiring to edit.
+  S.matrix=caps.matrix||null;
+  if(S.matrix&&S.matrix.fixed){
+    const w=S.matrix.width,h=S.matrix.height;
+    ICON_MAX=w;ICON_MAX_HEIGHT=h;
+    ICON_SIZES=h>8?[h+'x'+h,w+'x'+h,'8x8','32x8']:['8x8','32x8'];
+  }
+  if(caps.gpio&&caps.gpio.fixed){
+    for(const key of ['autoBrightness','useCelsius','temperatureColor','humidityColor'])
+      if(FIELDS[key])FIELDS[key].g='hidden';
+    for(const key of ['minBrightness','maxBrightness','tempDecimals','buttonCallback'])
+      if(SYSF[key])SYSF[key].g='hidden';
+    if(FIELDS.brightness)FIELDS.brightness.h='Sets the display brightness.|Stellt die Display-Helligkeit ein.';
+  }
   const a=caps.audio||{};
   S.aud={buzzer:a.buzzer===true,track:a.track===true,mp3:a.mp3===true,radio:a.radio===true};
 }
@@ -1602,6 +1616,15 @@ async function scriptsOff(){
   return S.scriptsOff;
 }
 function applyGpioCaps(c){
+  if(c.fixed){
+    for(const [key,field] of Object.entries(SYSF))
+      if(field.g==='gpio'||['panelWidth','panels','panelStart','panelWiring','panelColorOrder','panelSerpentine',
+        'panelChainReverse','panelChainSerpentine','dfplayer','tempOffset','humOffset',
+        'batteryDividerRatio','ldrFactor','ldrGamma','ldrOnGround','brightnessSmoothing',
+        'pinI2sMclk','pinAmpEnable'].includes(key))
+        field.g='hidden';
+    return;
+  }
   const dflt=c.defaults||{};
   const gp=p=>'GPIO '+p;
   const inR=(rs,p)=>(rs||[]).some(r=>p>=r[0]&&p<=r[1]);
@@ -2060,12 +2083,12 @@ function gifEncode(frames,W,H,SC){
   return new Uint8Array(b);
