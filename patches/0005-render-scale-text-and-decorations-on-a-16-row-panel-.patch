-        dst.setPixel(x + xOffset, y + yOffset, pixels_[static_cast<size_t>(y) * width_ + x]);
+        dst.setPixel(x + xOffset, y + yOffset,
+                     pixels_[static_cast<size_t>(y * sourceHeight_ / height_) * sourceWidth_ +
+                             x * sourceWidth_ / width_]);
   }
   int width() const override { return width_; }
+  int height() const override { return height_; }
   std::unique_ptr<IPageIcon> create() const override {
     return std::unique_ptr<IPageIcon>(new (std::nothrow) DevicePageIcon());
   }
 
  private:
+  // pixels_ keeps the source picture; width_ and height_ are what it covers on the panel.
+  void fitToPanel(int maxWidth) {
+    width_ = sourceWidth_;
+    height_ = sourceHeight_;
+#ifdef AWTRIX_TC002
+    // Classic tiles grow to 16x16; classic full-screen art fits the 52x16 panel.
+    // Native assets keep every source pixel, including full-screen 52x16 GIFs.
+    if (sourceHeight_ <= 8) {
+      width_ = std::min(maxWidth, sourceWidth_ * 2);
+      height_ = sourceHeight_ * 2;
+    }
+#else
+    (void)maxWidth;
+#endif
+  }
+
   media::PodBuffer<uint32_t> pixels_;
   GifPlayer gif_;
   int width_ = 0;
   int height_ = 0;
+  int sourceWidth_ = 0;
+  int sourceHeight_ = 0;
 };
 
