diff --git a/src/core/render/DisplayScale.h b/src/core/render/DisplayScale.h
new file mode 100644
index 0000000..be50fcd
--- /dev/null
+++ b/src/core/render/DisplayScale.h
@@ -0,0 +1,16 @@
+#pragma once
+
+namespace awtrix {
+
+// Text and thin decorations are drawn twice as large on a 16-row panel so the 32 by 8 layouts keep
+// their proportions. Explicit drawing coordinates remain physical pixels.
+inline int displayTextScale(int height) {
+#ifdef AWTRIX_TC002
+  return height >= 16 ? 2 : 1;
+#else
+  (void)height;
+  return 1;
+#endif
+}
+
+}
