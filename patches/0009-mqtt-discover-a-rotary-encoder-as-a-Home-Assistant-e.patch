+void test_knob_event_wraps_the_plain_payload() {
+  DiscoveryContext ctx = baseContext();
+  ctx.hasEncoder = true;
+  const std::string json = emitToString(ctx);
+
+  const JsonReader knob = at(at(parsed(json), "cmps"), "knob");
+  TEST_ASSERT_EQUAL_STRING("event", str(knob, "p").c_str());
+  TEST_ASSERT_EQUAL_STRING("~/state/knob", str(knob, "stat_t").c_str());
+  TEST_ASSERT_EQUAL_STRING("{\"event_type\":\"{{ value }}\"}", str(knob, "val_tpl").c_str());
+  JsonReader types = at(knob, "evt_typ");
+  TEST_ASSERT_TRUE(types.enterArray());
+  std::vector<std::string> names;
+  while (types.nextElement()) {
+    names.emplace_back();
+    types.appendString(names.back());
+    TEST_ASSERT_TRUE(types.skipValue());
+  }
+  TEST_ASSERT_EQUAL_size_t(2, names.size());
+  TEST_ASSERT_EQUAL_STRING("cw", names[0].c_str());
+  TEST_ASSERT_EQUAL_STRING("ccw", names[1].c_str());
+}
