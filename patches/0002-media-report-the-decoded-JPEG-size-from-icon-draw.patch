From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: awtrix-ng-tc002 <port@awtrix-ng-tc002.invalid>
Date: Wed, 16 Sep 2026 16:19:35 +0200
Subject: [PATCH 2/8] media: report the decoded JPEG size from icon::draw

Callers that place text next to an icon or blit it into a larger tile need the
real dimensions; both renderers also refuse a JPEG larger than the canvas.

diff --git a/src/media/IconRenderer.cpp b/src/media/IconRenderer.cpp
index f315092..9ae0283 100644
--- a/src/media/IconRenderer.cpp
+++ b/src/media/IconRenderer.cpp
@@ -26,7 +26,7 @@ bool jpgOutput(int16_t x, int16_t y, uint16_t w, uint16_t h, uint16_t* bitmap) {
 }
 }
 
-bool draw(Canvas& canvas, const std::string& iconId, int x, int y) {
+bool draw(Canvas& canvas, const std::string& iconId, int x, int y, int* width, int* height) {
   media::PodBuffer<uint8_t> buf;
   std::string path;
   // Same convention as GifPlayer: anything longer than a plausible filename is inline base64.
@@ -57,6 +57,17 @@ bool draw(Canvas& canvas, const std::string& iconId, int x, int y) {
     return false;
   }
 
+  uint16_t w = 0, h = 0;
+  if (TJpgDec.getJpgSize(&w, &h, buf.data(), buf.size()) != JDR_OK) {
+    logf("icon: %s is not a JPEG the decoder can read", label);
+    return false;
+  }
+  if (w > canvas.width() || h > canvas.height()) {
+    logf("icon: %s is %ux%u, larger than the panel", label, unsigned(w), unsigned(h));
+    return false;
+  }
+  if (width) *width = w;
+  if (height) *height = h;
   s_canvas = &canvas;
   TJpgDec.setJpgScale(1);
   TJpgDec.setCallback(jpgOutput);
diff --git a/src/media/IconRenderer.h b/src/media/IconRenderer.h
index 0a69c42..b377725 100644
--- a/src/media/IconRenderer.h
+++ b/src/media/IconRenderer.h
@@ -15,7 +15,7 @@ inline bool isPng(const uint8_t* data, std::size_t size) {
   return size >= 8 && std::memcmp(data, kMagic, sizeof(kMagic)) == 0;
 }
 
-bool draw(Canvas& canvas, const std::string& iconId, int x, int y);
+bool draw(Canvas& canvas, const std::string& iconId, int x, int y, int* width = nullptr, int* height = nullptr);
 
 }
 }
diff --git a/src/sim/SimIconRenderer.cpp b/src/sim/SimIconRenderer.cpp
index afc9f29..e89b4f5 100644
--- a/src/sim/SimIconRenderer.cpp
+++ b/src/sim/SimIconRenderer.cpp
@@ -47,7 +47,7 @@ int jpgOut(JDEC* jd, void* bitmap, JRECT* rect) {
 
 // Host half of icon::draw. The device goes through the Arduino TJpg_Decoder wrapper; here tjpgd is
 // driven directly, and the two must agree on pixel placement or the sim lies about what you'd see.
-bool draw(Canvas& canvas, const std::string& iconId, int x, int y) {
+bool draw(Canvas& canvas, const std::string& iconId, int x, int y, int* width, int* height) {
   media::PodBuffer<uint8_t> buf;
   std::string path;
   // Longer than any legal icon name, so treat it as an inline base64 JPEG rather than a lookup.
@@ -90,6 +90,12 @@ bool draw(Canvas& canvas, const std::string& iconId, int x, int y) {
     logf("icon: %s is not a JPEG the decoder can read", label);
     return false;
   }
+  if (jd.width > canvas.width() || jd.height > canvas.height()) {
+    logf("icon: %s is %ux%u, larger than the panel", label, unsigned(jd.width), unsigned(jd.height));
+    return false;
+  }
+  if (width) *width = jd.width;
+  if (height) *height = jd.height;
   jd.swap = 0;
   if (jd_decomp(&jd, jpgOut, 0) != JDR_OK) {
     logf("icon: %s is not a JPEG the decoder can read", label);
