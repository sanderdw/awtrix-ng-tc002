From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: awtrix-ng-tc002 <port@awtrix-ng-tc002.invalid>
Date: Wed, 16 Sep 2026 16:19:35 +0200
Subject: [PATCH 01/10] render: make the panel height and width build-time
 settings

A port for a taller panel (the 52 by 16 Ulanzi TC002) sets AWTRIX_MATRIX_HEIGHT and
AWTRIX_PANEL_WIDTH at build time. The defaults are the 32 by 8 device, so nothing
changes for ESP32 builds. GIF limits follow the panel at run time since 1.1.2.

diff --git a/src/core/render/MatrixLayout.h b/src/core/render/MatrixLayout.h
index ac81d44..2458207 100644
--- a/src/core/render/MatrixLayout.h
+++ b/src/core/render/MatrixLayout.h
@@ -8,7 +8,14 @@
 
 namespace awtrix {
 
-inline constexpr int kMatrixHeight = 8;
+// A port for a taller or wider panel sets these at build time; the defaults are the 32 by 8 device.
+#ifndef AWTRIX_MATRIX_HEIGHT
+#define AWTRIX_MATRIX_HEIGHT 8
+#endif
+#ifndef AWTRIX_PANEL_WIDTH
+#define AWTRIX_PANEL_WIDTH 32
+#endif
+inline constexpr int kMatrixHeight = AWTRIX_MATRIX_HEIGHT;
 inline constexpr int kMatrixWidthMin = 32;
 inline constexpr int kMatrixWidthMax = 128;
 
@@ -37,7 +44,7 @@ inline std::string enumNameChoices(const char* const* names, int count) {
 }
 
 struct MatrixLayout {
-  int panelWidth = 32;
+  int panelWidth = AWTRIX_PANEL_WIDTH;
   int panels = 1;
   PanelStart panelStart = PanelStart::TopLeft;
   Wiring panelWiring = Wiring::Rows;
diff --git a/src/persistence/DeviceConfig.h b/src/persistence/DeviceConfig.h
index 7c2ea74..4a23a1a 100644
--- a/src/persistence/DeviceConfig.h
+++ b/src/persistence/DeviceConfig.h
@@ -43,7 +43,7 @@ struct DeviceConfig {
   float ldrFactor = 1.0f, ldrGamma = 2.2f;
   bool ldrOnGround = false;
   long brightnessSmoothing = 10000;
-  int panelWidth = 32;
+  int panelWidth = AWTRIX_PANEL_WIDTH;
   int panels = 1;
   PanelStart panelStart = PanelStart::TopLeft;
   Wiring panelWiring = Wiring::Rows;
