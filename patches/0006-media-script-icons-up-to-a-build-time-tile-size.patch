From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: awtrix-ng-tc002 <port@awtrix-ng-tc002.invalid>
Date: Wed, 16 Sep 2026 16:19:35 +0200
Subject: [PATCH 6/8] media: script icons up to a build-time tile size

AWTRIX_SCRIPT_ICON_W/H default to the 8x8 tiles, so the cache stays 256 bytes
per entry on ESP32; a port with a larger panel raises them and the decoded
size (from icon::draw) drives the blit.

diff --git a/src/media/ScriptIcon.cpp b/src/media/ScriptIcon.cpp
index e64c6a8..62031ab 100644
--- a/src/media/ScriptIcon.cpp
+++ b/src/media/ScriptIcon.cpp
@@ -1,5 +1,7 @@
 #include "media/ScriptIcon.h"
 
+#include <algorithm>
+
 #include <new>
 
 #include "media/GifPlayer.h"
@@ -55,6 +57,8 @@ void ScriptIcon::load(Entry& e, int64_t nowMs) {
 
   if (r == GifPlayer::OpenResult::kGood) {
     e.anim = gif;
+    e.width = std::min(gif->width(), e.buf.width());
+    e.height = std::min(gif->height(), e.buf.height());
     gif->render(e.buf, nowMs);
     e.state = State::kGood;
     e.retryStep = 0;
@@ -72,7 +76,9 @@ void ScriptIcon::load(Entry& e, int64_t nowMs) {
   }
 
   // No GIF under that name, so fall back to the JPG icon of the same id.
-  e.state = icon::draw(e.buf, e.name, 0, 0) ? State::kGood : State::kMissing;
+  e.state = icon::draw(e.buf, e.name, 0, 0, &e.width, &e.height) ? State::kGood : State::kMissing;
+  e.width = std::min(e.width, e.buf.width());
+  e.height = std::min(e.height, e.buf.height());
   e.retryStep = 0;
 }
 
@@ -110,8 +116,8 @@ bool ScriptIcon::draw(Canvas& canvas, const std::string& name, int x, int y, int
 
   if (e->anim) e->anim->render(e->buf, nowMs);
 
-  for (int row = 0; row < 8; ++row)
-    for (int col = 0; col < 8; ++col)
+  for (int row = 0; row < e->height; ++row)
+    for (int col = 0; col < e->width; ++col)
       canvas.setPixel(x + col, y + row, e->buf.getPixel(col, row));
   return true;
 }
diff --git a/src/media/ScriptIcon.h b/src/media/ScriptIcon.h
index a993120..e8b4b93 100644
--- a/src/media/ScriptIcon.h
+++ b/src/media/ScriptIcon.h
@@ -8,11 +8,19 @@
 #include "core/render/Canvas.h"
 #include "core/script/ScriptServices.h"
 
+// A port with a larger panel raises the tile size at build time; the default keeps the 8x8 tiles.
+#ifndef AWTRIX_SCRIPT_ICON_W
+#define AWTRIX_SCRIPT_ICON_W 8
+#endif
+#ifndef AWTRIX_SCRIPT_ICON_H
+#define AWTRIX_SCRIPT_ICON_H 8
+#endif
+
 namespace awtrix {
 
 class GifPlayer;
 
-// Small LRU cache of decoded 8x8 icons for scripts. Scripts redraw every tick, so re-opening the
+// Small LRU cache of decoded icons for scripts. Scripts redraw every tick, so re-opening the
 // file each time would hammer the filesystem; the cache is deliberately tiny to bound RAM.
 class ScriptIcon : public script::IScriptIcon {
  public:
@@ -37,7 +45,8 @@ class ScriptIcon : public script::IScriptIcon {
 
   struct Entry {
     std::string name;
-    Canvas buf{8, 8};
+    Canvas buf{AWTRIX_SCRIPT_ICON_W, AWTRIX_SCRIPT_ICON_H};
+    int width = 0, height = 0;
     GifPlayer* anim = nullptr;
     bool occupied = false;
     State state = State::kMissing;
